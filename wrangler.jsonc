{
  // Cloudflare settings for Atrium: the built site in dist/ plus the small chat server in worker/
  "name": "atrium-heart",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Keep variables set in the Cloudflare dashboard (such as GEMINI_MODEL) when deploying
  "keep_vars": true,
  "observability": { "enabled": true }
}
